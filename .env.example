# 배포 환경에 맞게 모든 값을 직접 지정해야 합니다.
FORGEJO_API_URL=https://forge.example.com
FORGEJO_PUBLIC_URL=https://forge.example.com
FORGEJO_PAGES_OWNER=pages
PAGES_DOMAIN=pages.example.com
GIT_PAGES_URL=http://127.0.0.1:3000
WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

# 아래 값은 선택 사항입니다.
LISTEN_ADDRESS=:8081
MAX_WEBHOOK_BYTES=1048576
DEPLOY_TIMEOUT=90s
